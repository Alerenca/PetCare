            <% } %>
            
      </ul>
      <div class="nav-actions">
        <% if(usuario) { %>
          <% if(usuario.tipo === 'usuario') { %>
            <% if (usuario.rol === 'admin') { %>
            <a href="/admin/adminPanel" class="btn-ghost">Admin</a>
            <% } %>
            <% } %>
            <a href="/auth/logout" class="btn-primary">Cerrar sesión</a>
        <% } else { %>
            <a href="/auth/login" class="btn-ghost">Iniciar sesión</a>
            <a href="/auth/register" class="btn-primary">Registrarse</a>
        <% } %>

        <% if(usuario) { %>
          <% const urlPerfil = usuario.tipo === 'usuario' ? `/user/perfilUsuario/${usuario.id}` : `/user/perfilEmpresa/${usuario.id}`; %>
          <a href="<%= urlPerfil %>" class="nav-avatar-link">
            <div class="nav-avatar">
              <% if(usuario.foto) { %>
                <img src="<%= usuario.foto %>" alt="<%= usuario.nombre_usuario || usuario.nombre %>" class="nav-avatar-img">
              <% } else { %>
                <span class="nav-avatar-initials"><%= (usuario.nombre_usuario || usuario.nombre || 'U')[0].toUpperCase() %></span>
              <% } %>
            </div>
          </a>
        <% } %>
      </div>

      <button type="button" class="nav-toggle" id="nav-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-nav-menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </nav>

    <div id="mobile-nav-menu" class="mobile-nav-menu" hidden>
      <ul class="mobile-nav-links">
            <% if(usuario && usuario.tipo !== 'empresa') { %>
              <button type="button" id="mobile-btn-back" class="mobile-btn-back" style="display:none;">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="15 18 9 12 15 6"/>
                </svg>
                Atrás
              </button>
                <li><a href="/pets/mypets">Mis Mascotas</a></li>
                <li><a href="/services">Servicios</a></li>
                <li><a href="/services/mis-chats">Chats</a></li>
                <li><a href="/services/citas">Mis citas</a></li>
                <li><a href="/services/mis-anuncios">Mis anuncios</a></li>
                <li><a href="/sobre-nosotros">Sobre nosotros</a></li>
            <% } else { %>
              <button type="button" id="mobile-btn-back" class="mobile-btn-back" style="display:none;">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="15 18 9 12 15 6"/>
                </svg>
                Atrás
              </button>
                <li><a href="/services">Servicios</a></li>
                <li><a href="/sobre-nosotros">Sobre nosotros</a></li>
            <% } %>
      </ul>

      <div class="mobile-nav-actions">
    <% if(usuario) { %>
      <% if(usuario.tipo === 'usuario') { %>
        <% if (usuario.rol === 'admin') { %>
        <a href="/admin/dashboard" class="btn-ghost">Admin</a>
        <% } %>
        <a href="/user/perfilUsuario/<%= usuario.id %>" class="btn-ghost">Perfil</a>
      <% } else { %>
      <a href="/user/perfilEmpresa/<%= usuario.id %>" class="btn-ghost">Perfil</a>
      <% } %>
            <a href="/auth/logout" class="btn-primary">Cerrar sesión</a>
    <% } else { %>
            <a href="/auth/login" class="btn-ghost">Iniciar sesión</a>
            <a href="/auth/register" class="btn-primary">Registrarse</a>
    <% } %>
      </div>
    </div>

    <script>
      (function () {
        const toggle = document.getElementById('nav-toggle');
        const menu = document.getElementById('mobile-nav-menu');
        if (!toggle || !menu) return;

        function setMenuState(open) {
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          toggle.classList.toggle('is-open', open);
          menu.classList.toggle('is-open', open);
          menu.hidden = !open;
        }

        toggle.addEventListener('click', function () {
          const isOpen = toggle.getAttribute('aria-expanded') === 'true';
          setMenuState(!isOpen);
        });

        window.addEventListener('resize', function () {
          if (window.innerWidth > 768) {
            setMenuState(false);
          }
        });
      })();

      // Marcar enlace activo
      (function () {
        const path = window.location.pathname;
        document.querySelectorAll('.nav-links a, .mobile-nav-links a').forEach(function (a) {
          const href = a.getAttribute('href');
          if (!href) return;
          const match = href === '/' ? path === '/' : path === href;
          if (match) a.classList.add('nav-active');
        });
      })();

      // Historial de navegación propio
      (function () {
        const STORAGE_KEY = 'navStack';
        const currentUrl = window.location.pathname + window.location.search;

        // Si estamos en home, resetear el historial y no mostrar botón
        if (window.location.pathname === '/') {
          sessionStorage.removeItem(STORAGE_KEY);
          return;
        }

        // Si no estamos en home, gestionar el historial normalmente
        const stack = JSON.parse(sessionStorage.getItem(STORAGE_KEY) || '[]');

        if (stack[stack.length - 1] !== currentUrl) {
          stack.push(currentUrl);
          if (stack.length > 20) stack.shift();
          sessionStorage.setItem(STORAGE_KEY, JSON.stringify(stack));
        }

        function goBack() {
          stack.pop();
          const prev = stack[stack.length - 1];

          // Si la página anterior es home o no hay más páginas, ir a home y resetear
          if (!prev || prev === '/') {
            sessionStorage.removeItem(STORAGE_KEY);
            window.location.href = '/';
            return;
          }

          sessionStorage.setItem(STORAGE_KEY, JSON.stringify(stack));
          window.location.href = prev;
        }

        const btnBack = document.getElementById('btn-back');
        const mobileBtnBack = document.getElementById('mobile-btn-back');

        if (stack.length > 0) {
          if (btnBack) btnBack.style.display = 'inline-flex';
          if (mobileBtnBack) mobileBtnBack.style.display = 'block';
        }

        if (btnBack) btnBack.addEventListener('click', goBack);
        if (mobileBtnBack) mobileBtnBack.addEventListener('click', goBack);
      })();
    </script>